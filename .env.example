# ==========================================
# VeriLoan Backend Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Optional - free tier at https://aistudio.google.com/apikey)
# If provided, VeriLoan uses Gemini 1.5 Flash for live root-cause explanations and queue triage.
# If omitted, VeriLoan seamlessly uses its deterministic offline financial heuristic engine.
GEMINI_API_KEY=

# 2. Database Connection URL (Defaults to local SQLite copilot.db)
DATABASE_URL=sqlite:///./copilot.db

# 3. Offline AI Fallback Switch (True enables local deterministic reasoning when offline)
ENABLE_OFFLINE_AI_FALLBACK=True
